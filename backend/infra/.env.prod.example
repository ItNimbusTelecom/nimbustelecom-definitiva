# Configuracion de despliegue de PRODUCCION.
#
# Copia este fichero a .env.prod, rellenalo y NO lo subas: el repo es publico.
# Lo lee bin/nimbus-funnel-backend.ts cuando se despliega con -c stage=prod.
# Una variable ya presente en el entorno gana sobre la de aqui.

# --- Cuenta de AWS -----------------------------------------------------------
# Produccion vive en la cuenta de Nimbus, no en la personal de nadie. Si las
# credenciales activas son de otra cuenta, el despliegue para en seco en vez de
# crear una copia del stack donde no toca.
#   aws sts get-caller-identity --profile nimbus
NIMBUS_PROD_ACCOUNT=
NIMBUS_PROD_REGION=eu-west-1

# --- CORS --------------------------------------------------------------------
# Separados por comas. Si se queda vacio, la API acepta peticiones desde
# cualquier web.
FRONTEND_ALLOWED_ORIGINS=https://nimbustelecom.cat

# --- Webhooks de Make --------------------------------------------------------
# Si faltan, el despliegue para: sin ellos el lead se guarda en DynamoDB, no
# llega a ISP y no salta ninguna alarma. Los valores vivos:
#   aws lambda get-function-configuration --profile nimbus \
#     --function-name nimbus-funnel-api-prod --query 'Environment.Variables'
MAKE_LEAD_WEBHOOK_URL=
MAKE_COVERAGE_WEBHOOK_URL=

# --- reCAPTCHA ---------------------------------------------------------------
# Activarlo SOLO cuando este publicada la web que envia el token; si no, todos
# los envios daran 400.
#
# La clave secreta es la pareja de la clave de sitio que ya usaba el backend de
# formularios de la web de WordPress, asi que no hay que crear ninguna nueva:
#   aws lambda get-function-configuration --profile nimbus \
#     --function-name NimbusTelecomFormsBackend-SubmitFormFunctionF94246-buzomlOIbCYk \
#     --query 'Environment.Variables.RECAPTCHA_SECRET' --output text
#
# Antes de activarlo: comprobar en la consola de reCAPTCHA que nimbustelecom.cat
# esta en la lista de dominios de esa clave. Las claves estan atadas al dominio
# y la lista viene de la epoca de WordPress.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=
