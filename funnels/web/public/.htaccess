# =============================================================================
#  nimbustelecom.cat  -  Apache (SWHosting)
#  Web estatica (Next.js export). Sin PHP, sin base de datos.
#
#  Este fichero es la BASE. Las redirecciones de las URLs antiguas NO se
#  escriben a mano: funnels/scripts/preparar-swhosting.sh las genera a partir
#  de las paginas de redireccion (stubs) que hay en public/ y las anade al
#  final de out/.htaccess. Asi no pueden quedar desfasadas respecto a las
#  rutas reales de la web.
#
#  Vale igual para staging y para produccion: el bloque noindex se activa solo
#  si el host contiene "staging". NO hay que editarlo al publicar.
#
#  En GitHub Pages este fichero se ignora.
# =============================================================================

# -------------------------------------------------- no listar directorios
Options -Indexes

# -------------------------------------------------- pagina 404 propia
ErrorDocument 404 /404.html

# -------------------------------------------------- tipos que Apache puede no conocer
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType text/plain .txt
AddDefaultCharset utf-8
AddCharset utf-8 .txt .xml .html .css .js

# -------------------------------------------------- https y dominio sin www
# Una sola URL buena: https://nimbustelecom.cat/...
# Se deja pasar /.well-known/acme-challenge/ para que el certificado de
# Let's Encrypt se pueda renovar por http.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTP_HOST} ^www\.nimbustelecom\.cat$ [NC]
  RewriteRule ^ https://nimbustelecom.cat%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# -------------------------------------------------- staging: fuera de Google
# Evita que el buscador indexe una copia de la web (contenido duplicado).
# Se aplica SOLO si el dominio contiene "staging". Requiere mod_headers.
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} =~ /staging/">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# -------------------------------------------------- cache
# Los ficheros de /_next/static/ llevan un hash en el nombre: si cambia el
# contenido, cambia el nombre. Por eso se pueden cachear un ano entero.
# El HTML no se cachea, para que una publicacion se vea al momento.
# (No se usa <LocationMatch>: en .htaccess no esta permitido y da error 500.)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#(\.html|/)$#">
    Header set Cache-Control "no-cache"
  </If>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

# -------------------------------------------------- compresion
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# -------------------------------------------------- cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "frame-ancestors 'self' https://ofertes.nimbustelecom.cat"
</IfModule>

# =============================================================================
#  REDIRECCIONES 301 DE LAS URLS ANTIGUAS
#  (las anade preparar-swhosting.sh debajo de esta linea; no editar a mano)
# =============================================================================
