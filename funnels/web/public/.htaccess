# =============================================================================
#  nimbustelecom.cat  -  Apache
#  Web estatica (Next.js export). Sin PHP, sin base de datos.
#
#  Este fichero vale IGUAL para staging y para produccion:
#  el bloque noindex se activa solo si el host contiene "staging".
#  NO hay que editarlo al publicar.
# =============================================================================

# -------------------------------------------------- no listar directorios
Options -Indexes

# -------------------------------------------------- pagina 404 propia
ErrorDocument 404 /404.html

# -------------------------------------------------- staging: fuera de Google
# Evita que el buscador indexe una copia de la web (contenido duplicado).
# Se aplica SOLO si el dominio contiene "staging", asi que en produccion
# no hace nada. Requiere mod_headers.
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} =~ /staging/">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# -------------------------------------------------- cache de los assets
# Los ficheros de /_next/ llevan un hash en el nombre: si cambia el
# contenido, cambia el nombre. Por eso se pueden cachear un ano entero.
<IfModule mod_expires.c>
  ExpiresActive On
  <LocationMatch "^/_next/">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "immutable"
  </LocationMatch>
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

# -------------------------------------------------- compresion
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -------------------------------------------------- cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "frame-ancestors 'self' https://ofertes.nimbustelecom.cat"
</IfModule>

# =============================================================================
#  REDIRECCIONES 301 DE LAS URLS DEL WORDPRESS ANTIGUO
#
#  Se usa RedirectMatch con la ruta ANCLADA (^...$) en vez de Redirect,
#  porque Redirect funciona por prefijo: "Redirect 301 /es /" se llevaria
#  tambien /es/aviso-legal, y /internet entraria en bucle con
#  /internet/fibra. Con anclaje cada regla coincide con su ruta exacta.
#
#  Generado a partir de los 83 stubs de funnels/web/public/.
# =============================================================================

RedirectMatch 301 ^/alarma-de-seguridad-sms-fraudulentos-en-facturas-protegete/?$ /
RedirectMatch 301 ^/alerta-cuidado-con-las-llamadas-fraudulentas-la-doble-trucada/?$ /
RedirectMatch 301 ^/author/nimbustelecom/?$ /
RedirectMatch 301 ^/avis-legal-2/?$ /aviso-legal/
