RedirectMatch 301 ^/category/alerta/?$ /
RedirectMatch 301 ^/category/nimbustelecom-2/?$ /
RedirectMatch 301 ^/category/noticias/?$ /
RedirectMatch 301 ^/chat/?$ /
RedirectMatch 301 ^/cobertura/?$ /movil/
RedirectMatch 301 ^/contacte/?$ /#contacte
RedirectMatch 301 ^/contacto/?$ /#contacte
RedirectMatch 301 ^/el-portal-del-client-de-nimbustelecom-mes-transparencia-i-control/?$ /
RedirectMatch 301 ^/empresa/?$ /empreses/
RedirectMatch 301 ^/es/aviso-legal/?$ /aviso-legal/
